# 由官方 nginx 镜像在启动时按环境变量渲染（BACKEND_UPSTREAM 在 Dockerfile 里给了默认值）。
# 单独起容器时指到别的后端：docker run -e BACKEND_UPSTREAM=10.0.0.5:8082 ...
#
# 为什么写成 $BACKEND_UPSTREAM 而不是 BACKEND_UPSTREAM：envsubst 只认 "$名字"，
# 少了 $ 就会把字面量留在配置里，nginx 启动即 emerg "host not found in upstream"。
# 而替换发生在 nginx 解析之前，渲染出来的是**字面主机名**（不是 nginx 运行期变量），
# 所以不需要 resolver 指令 —— 换成 nginx 变量写法反而会要 Docker 内置 DNS。

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 后端只有这一个媒体资产是动态取的（cmd.go 把三方 vendor 脚本挂在 /assets/media-player.js）。
    # 精确匹配优先于下面的 /assets/ 前缀，所以 vite 自己产出的 /assets/*.js 仍从本地磁盘走。
    location = /assets/media-player.js {
        proxy_pass http://$BACKEND_UPSTREAM;
        proxy_set_header Host $host;
    }

    location /api/ {
        proxy_pass http://$BACKEND_UPSTREAM;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # WebSocket：会中状态推送。少了 Upgrade/Connection 这两行会静默退化成普通请求，
    # 表现为"会议里成员进出没反应"，所以单独标出来。
    location /ws {
        proxy_pass http://$BACKEND_UPSTREAM;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 联调用：接口清单与在线调试页
    location = /api.json { proxy_pass http://$BACKEND_UPSTREAM; }
    location /swagger { proxy_pass http://$BACKEND_UPSTREAM; }

    # vite 产物带内容哈希，可长期缓存；index.html 不能缓存，否则发版后拿旧引用
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-store";
        try_files $uri $uri/ /index.html;
    }
}
