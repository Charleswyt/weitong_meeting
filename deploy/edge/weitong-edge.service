[Unit]
Description=Weitong standalone board meeting and Rockchip video gateway
After=network-online.target rtsp-roi.service weitong-edge-media.service
Wants=network-online.target
Requires=weitong-edge-media.service

[Service]
Type=exec
User=weitong-edge
Group=weitong-edge
SupplementaryGroups=video render
ExecStart=/opt/weitong-edge/current/edge -config /etc/weitong-edge/config.json
Environment=LD_LIBRARY_PATH=/opt/rtsp_roi/runtime/ffmpeg-rockchip/prefix/lib
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
KillMode=control-group
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
